# Copie para frontend/.env.local e preencha. Nunca envie o arquivo preenchido para o GitHub.

# Chave do Google Maps para o mapa no navegador (restrita por site no Google Cloud)
VITE_GOOGLE_MAPS_API_KEY=

# Opcional: endereço do backend (ex.: http://localhost:5001 para a cópia de testes).
# Vazio = mesmo computador, porta 5000.
VITE_API_URL=
