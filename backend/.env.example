# Copie para backend/.env e preencha. Nunca envie o .env para o GitHub.

# Firebird (Cartmaster)
FIREBIRD_HOST=
FIREBIRD_PORT=3050
FIREBIRD_DATABASE=
FIREBIRD_USER=
FIREBIRD_PASSWORD=

# Chave do Google para Geocoding e Routes (restrita pelo IP do servidor)
GOOGLE_MAPS_API_KEY=

# Opcional: porta do servidor (padrão 5000). Use outra porta para rodar uma cópia de testes.
FIVEL_PORT=

# Opcional: origens liberadas no CORS, separadas por vírgula (ex.: https://fivel.suaempresa.com.br).
# Vazio = libera só endereços da rede local.
CORS_ORIGINS=
